<ui version="4.0">
 <class>WelcomeScreen</class>
 <widget class="QWidget" name="WelcomeScreen">
  <property name="acceptDrops"><bool>true</bool></property>
  <layout class="QVBoxLayout" name="outerLayout">
   <property name="leftMargin"><number>32</number></property>
   <property name="rightMargin"><number>32</number></property>
   <property name="topMargin"><number>24</number></property>
   <property name="bottomMargin"><number>24</number></property>
   <item><spacer name="topSpace"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>0</width><height>24</height></size></property></spacer></item>
   <item alignment="Qt::AlignHCenter">
    <widget class="QWidget" name="homeContent">
     <property name="maximumSize"><size><width>980</width><height>500</height></size></property>
     <layout class="QHBoxLayout" name="contentLayout" stretch="3,0,4">
      <property name="spacing"><number>32</number></property>
      <item>
       <widget class="QWidget" name="introPanel">
        <layout class="QVBoxLayout" name="introLayout">
         <property name="spacing"><number>16</number></property>
         <item alignment="Qt::AlignLeft"><widget class="QLabel" name="appIcon"><property name="minimumSize"><size><width>96</width><height>96</height></size></property></widget></item>
         <item><widget class="QLabel" name="welcomeTitle"><property name="font"><font><pointsize>20</pointsize><bold>true</bold></font></property><property name="text"><string>Welcome to Okular</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
         <item><widget class="QLabel" name="welcomeDescription"><property name="text"><string>Read, annotate and explore your documents.
Open a file to get started.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
         <item alignment="Qt::AlignLeft"><widget class="QPushButton" name="openButton"><property name="text"><string>Open Document…</string></property><property name="icon"><iconset theme="document-open"/></property><property name="default"><bool>true</bool></property></widget></item>
         <item><widget class="QLabel" name="openShortcut"><property name="text"><string notr="true">Ctrl + O</string></property></widget></item>
         <item><widget class="QLabel" name="emptyDropArea"><property name="minimumSize"><size><width>0</width><height>54</height></size></property><property name="alignment"><set>Qt::AlignCenter</set></property><property name="text"><string>Drop a document here to open it</string></property></widget></item>
        </layout>
       </widget>
      </item>
      <item><widget class="QFrame" name="divider"><property name="frameShape"><enum>QFrame::VLine</enum></property><property name="frameShadow"><enum>QFrame::Plain</enum></property></widget></item>
      <item>
       <widget class="QWidget" name="recentPanel">
        <property name="minimumSize"><size><width>320</width><height>0</height></size></property>
        <layout class="QVBoxLayout" name="recentLayout">
         <property name="spacing"><number>12</number></property>
         <item>
          <layout class="QHBoxLayout" name="recentHeader">
           <item><widget class="QLabel" name="recentTitle"><property name="text"><string>Recently Opened</string></property><property name="font"><font><pointsize>13</pointsize><bold>true</bold></font></property></widget></item>
           <item alignment="Qt::AlignRight"><widget class="QToolButton" name="forgetAllButton"><property name="text"><string>Clear History</string></property><property name="autoRaise"><bool>true</bool></property></widget></item>
          </layout>
         </item>
         <item><widget class="QListView" name="recentsListView"><property name="minimumSize"><size><width>0</width><height>216</height></size></property><property name="frameShape"><enum>QFrame::NoFrame</enum></property><property name="horizontalScrollBarPolicy"><enum>Qt::ScrollBarAlwaysOff</enum></property><property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property><property name="selectionMode"><enum>QAbstractItemView::SingleSelection</enum></property></widget></item>
         <item><widget class="QLabel" name="documentDropArea"><property name="minimumSize"><size><width>0</width><height>54</height></size></property><property name="alignment"><set>Qt::AlignCenter</set></property><property name="text"><string>Drop a document here to open it</string></property></widget></item>
        </layout>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item><spacer name="bottomSpace"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>0</width><height>24</height></size></property></spacer></item>
